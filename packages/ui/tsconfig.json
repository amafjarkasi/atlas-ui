{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "paths": {
      "@atlas/ui": ["./src/index.ts"],
      "@atlas/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
